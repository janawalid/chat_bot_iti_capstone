# Copy this file to .env and adjust values as needed

# Path to the persisted Chroma vector store (copied from notebooks/../data/vector_store)
VECTOR_STORE_PATH=data/vector_store
COLLECTION_NAME=ml_docs

# Embedding model must match the one used in the notebook
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Ollama model used for generation
OLLAMA_MODEL=llama3.2

# Number of chunks to retrieve per query
RETRIEVAL_K=3

# Origin(s) allowed to call this API (your frontend's URL)
CORS_ORIGINS=http://localhost:8501
